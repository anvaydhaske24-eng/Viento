{
  "manifest_version": 3,
  "name": "Viento",
  "version": "0.1",
  "description": "A calmer web for everyone.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["calm/calm.css", "hover/hover.css", "gist/gist.css"],
      "js": [
        "lib/Readability.js",
        "lib/Readability-readerable.js",
        "calm/focus.js",
        "calm/calm.js",
        "hover/hover.js",
        "gist/gist.js"
      ]
    }
  ],
  "background": { "service_worker": "hover/background.js" },
  "permissions": ["tts"],
  "web_accessible_resources": [
    { "resources": ["calm/fonts/*.ttf"], "matches": ["<all_urls>"] }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
